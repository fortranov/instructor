# Пример файла переменных окружения для миграций
# Скопируйте этот файл в .env.migration и настройте под ваши нужды

# SQLite (по умолчанию)
DATABASE_URL=sqlite:///./triplan.db

# PostgreSQL
# POSTGRES_URL=postgresql://username:password@localhost:5432/triplan

# MySQL
# MYSQL_URL=mysql://username:password@localhost:3306/triplan

# Дополнительные настройки
# VERBOSE=true
# DRY_RUN=false

